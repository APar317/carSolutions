{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/services", "dest": "/services.html" },
    { "src": "/pricing", "dest": "/pricing.html" },
    { "src": "/packages", "dest": "/packages.html" },
    { "src": "/appointment", "dest": "/appointment.html" }
  ]
}
